# Sao chép tệp này thành .env rồi điền giá trị thật của dự án Supabase.
# Không commit .env lên git.

# Session Pooler (IPv4) — khuyến nghị cho máy không có IPv6
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Direct connection (chỉ IPv6)
DIRECT_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Transaction Pooler (cổng 6543)
TRANSACTION_POOLER_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<plain-password>
DB_SSL=true

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gửi email ứng viên: auto | smtp | ethereal | file
#   ethereal → gửi thật qua hộp thư thử nghiệm, mỗi thư có preview_url để xem lại
EMAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hr@smartats.vn
MAIL_OUTBOX_DIR=mail-outbox
